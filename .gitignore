# ============================================================
#  Jax — Unity 工程 .gitignore
#  本仓库只纳入代码与配置，不纳入任何美术/音频等资源文件。
#  注意：排除资源目录时同时排除其 .meta，避免留下孤儿 meta。
# ============================================================

# ---------- Unity 生成目录 / 缓存 ----------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Bb]undles/
/[Hh]ybridCLRData/

# ---------- IDE / 解决方案文件（由 Unity 重新生成） ----------
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/
.idea/

# ---------- 构建产物 ----------
*.apk
*.aab
*.app
*.unitypackage
sysinfo.txt
crashlytics-build.properties

# ---------- YooAsset 热更打包产物 ----------
/Assets/StreamingAssets/yoo
/Assets/StreamingAssets/yoo.meta

